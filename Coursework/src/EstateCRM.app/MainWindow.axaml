<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EstateCRM.App.MainWindow"
        Title="EstateCRM"
        Width="1180" Height="820"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*" Background="White">
    <Border Background="#1E5AA8" Padding="24,16">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel>
          <TextBlock Text="EstateCRM" Foreground="White"
                     FontSize="25" FontWeight="SemiBold"/>
          <TextBlock Text="Агентство недвижимости" Foreground="White"/>
        </StackPanel>
        <TextBlock x:Name="UserText" Grid.Column="1"
                   Text="Вход не выполнен" Foreground="White"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="24,0,0,0" TextWrapping="Wrap" MaxWidth="620"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#EEF3F8" Padding="16,10">
      <WrapPanel>
        <Button x:Name="BackButton" Content="Назад" Margin="0,0,8,6"
                Click="BackClick" IsEnabled="False"/>
        <Button x:Name="CatalogButton" Content="Каталог" Margin="0,0,8,6"
                Click="CatalogClick" IsEnabled="False"/>
        <Button x:Name="ViewingsButton" Content="Подбор и просмотры" Margin="0,0,8,6"
                Click="ViewingsClick" IsEnabled="False"/>
        <Button x:Name="DealsButton" Content="Сделки" Margin="0,0,8,6"
                Click="DealsClick" IsEnabled="False"/>
        <Button x:Name="ReportButton" Content="Сводка по сделкам" Margin="0,0,8,6"
                Click="ReportClick" IsVisible="False"/>
        <Button x:Name="LogoutButton" Content="Выйти" Margin="0,0,8,6"
                Click="LogoutClick" IsVisible="False"/>
      </WrapPanel>
    </Border>
    <ContentControl x:Name="PageHost" Grid.Row="2"/>
  </Grid>
</Window>
